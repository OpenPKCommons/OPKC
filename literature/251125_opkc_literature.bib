	pages = {189--198},
	file = {PDF:/Users/ellendegenn/Zotero/storage/JZ8R4QWT/Lindeboom et al. - 2024 - Human SARS-CoV-2 challenge uncovers local and systemic response dynamics.pdf:application/pdf},
