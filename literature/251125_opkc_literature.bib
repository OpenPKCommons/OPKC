	url = {https://agsjournals.onlinelibrary.wiley.com/doi/10.1111/jgs.19499},
	doi = {10.1111/jgs.19499},
	abstract = {Background: Nursing homes (NHs) were disproportionately affected by the COVID-­19 pandemic. However, little is known regarding the kinetics of SARS-­CoV-­2 shedding in NH residents and staff, which could inform treatment and infection prevention. Methods: We enrolled NH residents and staff in eight US states from April to November 2023 and analyzed the kinetics of SARS-­CoV-­2 using serial antigen and molecular (RT-P­ CR) tests, whole genome sequencing, and viral culture (VC). Symptoms, vaccination, and treatment were collected via interviews and chart review. Viral load trajectories were modeled with gamma distribution functional forms. Antigen and VC test positivity over time were assessed using a Chi-­squared test.},
