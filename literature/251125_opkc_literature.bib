	keywords = {FMD, MO},
	pages = {268--286},
	file = {PDF:/Users/ellendegenn/Zotero/storage/SJ6QPR3P/Akter and Deardon - 2025 - Conditional logistic individual-level models of spatial infectious disease dynamics.pdf:application/pdf},
}

