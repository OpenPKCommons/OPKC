	file = {PDF:/Users/ellendegenn/Zotero/storage/7W6M6KZ4/Sloan et al. - 2020 - Clinical and virological responses to a broad-spectrum human monoclonal antibody in an influenza vir.pdf:application/pdf;Sloan et al Antiviral Res 2020 Clinical and virological responses to a broad-spectrum human monoclonal antibody in an influenza virus challenge study Supplementary data-mmc1:/Users/ellendegenn/Zotero/storage/LDTHUKH3/Sloan et al Antiviral Res 2020 Clinical and virological responses to a broad-spectrum human monoclonal antibody in an influenza virus challenge study Supplementary data-mmc1.docx:application/vnd.openxmlformats-officedocument.wordprocessingml.document;Sloan et al Antiviral Res 2020 Clinical and virological responses to a broad-spectrum human monoclonal antibody in an influenza virus challenge study Supplementary data-mmc2:/Users/ellendegenn/Zotero/storage/ATAUFBWL/Sloan et al Antiviral Res 2020 Clinical and virological responses to a broad-spectrum human monoclonal antibody in an influenza virus challenge study Supplementary data-mmc2.docx:application/vnd.openxmlformats-officedocument.wordprocessingml.document;Sloan et al Antiviral Res 2020 Clinical and virological responses to a broad-spectrum human monoclonal antibody in an influenza virus challenge study Supplementary data-mmc3:/Users/ellendegenn/Zotero/storage/LRJSQ7LG/Sloan et al Antiviral Res 2020 Clinical and virological responses to a broad-spectrum human monoclonal antibody in an influenza virus challenge study Supplementary data-mmc3.docx:application/vnd.openxmlformats-officedocument.wordprocessingml.document},
