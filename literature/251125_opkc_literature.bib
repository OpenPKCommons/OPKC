	title = {Kinetics of {\textless}span style="font-variant:small-caps;"{\textgreater}{SARS}{\textless}/span{\textgreater} ‐ {\textless}span style="font-variant:small-caps;"{\textgreater}{CoV}{\textless}/span{\textgreater} ‐2 {Shedding} in {Nursing} {Home} {Residents} and {Staff}},
